/**
 * DISABLED IN CI — v7 §7 named regression tests for the §1 critical bugs +
 * §4/§5 classes. Same reason as auth.e2e-spec.ts.disabled: this suite calls
 * a REAL running backend over HTTP (localhost:4000 by default) and reads
 * admin creds from backend/.env. GitHub Actions CI has no Postgres, Redis,
 * or backend process running, so this can never pass there no matter what
 * secrets/env vars are added — the .env-file suggestion from an earlier
 * pass was wrong for that reason.
 *
 * Run this manually instead, against a real environment:
 *   1) Local:  docker compose up -d backend  (needs backend/.env with
 *              ADMIN_DEFAULT_EMAIL / ADMIN_DEFAULT_PASSWORD), then run:
 *              cd backend && npx jest --config test/jest-e2e.json --runInBand \
 *                --forceExit test/regression-v7.e2e-spec.ts.disabled
 *   2) Prod:   TEST_API_BASE=https://sscprephub.in/api/v1 npx jest ... (same)
 *
 * Rename this file back to *.e2e-spec.ts (drop .disabled) to run it with
 * the normal `npm test` command.
 */
import * as fs from 'fs';
import * as path from 'path';

const API = process.env.TEST_API_BASE || 'http://localhost:4000/api/v1';

function adminCreds() {
  const raw = fs.readFileSync(path.join(__dirname, '..', '.env'), 'utf8');
  const get = (k: string) => raw.match(new RegExp(`^${k}=["']?(.*?)["']?$`, 'm'))?.[1] ?? '';
  return { email: get('ADMIN_DEFAULT_EMAIL'), password: get('ADMIN_DEFAULT_PASSWORD') };
}

let token = '';
async function api(method: string, p: string, body?: unknown) {
  const res = await fetch(`${API}${p}`, {
    method,
    headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) },
    body: body === undefined ? undefined : JSON.stringify(body),
  });
  const json = await res.json().catch(() => ({}));
  return { status: res.status, json };
}

beforeAll(async () => {
  const { email, password } = adminCreds();
  const r = await api('POST', '/auth/login', { email, password, platform: 'WEB', deviceId: 'v7-regression' });
  token = r.json.accessToken ?? '';
  expect(token).toBeTruthy();
});

describe('v7 §1.1 — submit/autosave flow (was: crash-on-submit class)', () => {
  it('start → autosave → submit returns SUBMITTED with per-question answers', async () => {
    // use a FREE template (premium ones 400 without a purchase)
    const list = await api('GET', '/tests');
    const tpl = (list.json ?? []).find((t: any) => !t.isPremium)?.id;
    expect(tpl).toBeTruthy();
    const start = await api('POST', '/tests/attempts/start', { testTemplateId: tpl });
    expect(start.status).toBe(201);
    const attemptId = start.json.id;
    expect(attemptId).toBeTruthy();

    const paper = await api('GET', `/tests/paper/${tpl}`);
    expect(paper.status).toBe(200);
    const qs = (paper.json.sections ?? []).flatMap((s: any) => s.questions ?? []);
    expect(qs.length).toBeGreaterThan(0);
    const q0 = qs[0].id;

    const save = await api('PUT', `/tests/attempts/${attemptId}/answers`, {
      answers: [{ questionId: q0, selectedOption: 'A' }],
      timeSpentByQuestion: { [q0]: 9 },
    });
    expect(save.status).toBe(200);
    expect(save.json.saved).toBe(1);

    const remaining = await api('GET', `/tests/attempts/${attemptId}/remaining`);
    expect((remaining.json.answers ?? []).length).toBe(1);

    const submit = await api('POST', `/tests/attempts/${attemptId}/submit`, {
      answers: [{ questionId: q0, selectedOption: 'A', timeSpentSeconds: 9 }],
    });
    expect(submit.status).toBe(201);
    expect(['SUBMITTED', 'AUTO_SUBMITTED']).toContain(submit.json.status);
    expect((submit.json.answers ?? []).length).toBeGreaterThanOrEqual(1);

    // cleanup the seeded attempt (keep the bank pristine)
    await api('POST', '/tests/attempts/start', { testTemplateId: tpl }); // noop-resume guard
  });
});

describe('v7 §1.4 — count integrity (dropdown count == load count)', () => {
  it('chapters(examId) count matches browse(chapterId+examId) total', async () => {
    const subjects = await api('GET', '/bank/subjects?examId=exam-cgl');
    expect(subjects.status).toBe(200);
    const sub = subjects.json.find((s: any) => s.questionCount > 0);
    expect(sub).toBeTruthy();

    const chapters = await api('GET', `/bank/chapters?subjectId=${sub.id}&examId=exam-cgl`);
    const checked: string[] = [];
    for (const c of (chapters.json ?? []).slice(0, 5)) {
      const browse = await api('GET', `/bank/questions?examId=exam-cgl&chapterId=${c.id}&take=5`);
      expect(browse.status).toBe(200);
      expect(browse.json.total).toBe(c.count);
      checked.push(`${c.name}:${c.count}=${browse.json.total}`);
    }
    expect(checked.length).toBeGreaterThan(0);
  });
});

describe('v7 §5 — translation queue visibility', () => {
  it('translation-stats + queue endpoints answer with totals', async () => {
    const stats = await api('GET', '/admin/pdf-ingestion/translation-stats');
    expect(stats.status).toBe(200);
    expect(Array.isArray(stats.json.byExam)).toBe(true);

    const queue = await api('GET', '/admin/pdf-ingestion/translation-queue?take=10');
    expect(queue.status).toBe(200);
    expect(queue.json.total).toBeGreaterThan(0);
    expect((queue.json.data ?? []).length).toBeGreaterThan(0);
  });
});

describe('v7 §4 — weak-topic drill is real', () => {
  it('drill endpoint returns approved questions with answers/solutions', async () => {
    const chapters = await api('GET', '/bank/chapters?examId=exam-cgl');
    const c = (chapters.json ?? []).find((x: any) => x.count >= 35);
    if (!c) return; // pool too small in this env — nothing to assert
    const drill = await api('GET', `/analytics/chapter/${c.id}/drill`);
    expect(drill.status).toBe(200);
    expect((drill.json.drill ?? []).length).toBeGreaterThan(0);
    expect(Object.prototype.hasOwnProperty.call(drill.json.drill[0], 'answer')).toBe(true);
  });
});
