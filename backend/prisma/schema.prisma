// SSC Prep Hub — Prisma Database Schema
// Database: PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
  MODERATOR
}

enum Platform {
  WEB
  APP
}

enum TestType {
  CHAPTER
  TOPIC
  SUBJECT
  MINI_MOCK
  FULL_MOCK
  PREVIOUS_YEAR
  SHIFT_WISE
  YEAR_WISE
  CUSTOM
  DAILY_PRACTICE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExplanationSource {
  PDF
  AI_GENERATED
  HUMAN_VERIFIED
}

enum TranslationStatus {
  HUMAN_VERIFIED
  AUTO_UNVERIFIED
}

enum VideoSource {
  YOUTUBE
  VIMEO
  S3_R2
  CUSTOM
}

enum ImportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum ChunkStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  SKIPPED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}

// ================= USER & AUTHENTICATION =================

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  phone            String?         @unique
  fullName         String
  passwordHash     String
  role             Role            @default(STUDENT)
  isEmailVerified  Boolean         @default(false)
  avatarUrl        String?
  
  // Gamification & Daily Streaks
  currentStreak    Int             @default(0)
  longestStreak    Int             @default(0)
  lastPracticeDate DateTime?
  xp               Int             @default(0)
  coins            Int             @default(0)
  hintQuota        Int             @default(3)

  // Referral
  referralCode     String?         @unique
  referredByCode   String?         // referral code user signed up with
  freeSubFromReferral Boolean      @default(false)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  sessions         DeviceSession[]
  refreshTokens    RefreshToken[]
  subscriptions    Subscription[]
  payments         Payment[]
  testAttempts     TestAttempt[]
  bookmarks        Bookmark[]
  notes            UserNote[]
  dailyPractices   DailyPracticeHistory[]
  auditLogs        AuditLog[]
  dailyQuizAttempts DailyQuizAttempt[]
  weakTopicReports  WeakTopicReport[]
  mockAccesses      MockAccess[]
  chapterPurchases  ChapterPurchase[]
  referralsMade     Referral[]      @relation("Referrer")
  referralsReceived Referral[]      @relation("Referee")
  studyPlans        StudyPlan[]
  telegram          TelegramUser?
  reviewCards       ReviewCard[]
  errorReports      QuestionErrorReport[]
  searchMisses      SearchMiss[]

  @@map("users")
}

// ================= SPACED REPETITION =================
// SM-2 inspired review queue: wrong/weak answers schedule a card,
// correct answers space it out (1d → 3d → 7d → 14d → 30d).
model ReviewCard {
  id            String   @id @default(uuid())
  userId        String
  questionId    String
  easeFactor    Float    @default(2.5)   // SM-2 ease factor
  repetitions   Int      @default(0)     // consecutive correct reps
  intervalDays  Int      @default(1)
  dueAt         DateTime @default(now()) // when next review is due
  lapses        Int      @default(0)     // times card was forgotten
  suspended     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, dueAt, suspended])
  @@map("review_cards")
}

model DeviceSession {
  id           String   @id @default(uuid())
  userId       String
  platform     Platform
  deviceId     String
  ipAddress    String?
  userAgent    String?
  location     String?
  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform, isActive])
  @@map("device_sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ================= TAXONOMY & QUESTION BANK =================

model Exam {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "SSC CGL", "SSC CHSL"
  slug      String   @unique
  code      String   @unique // e.g. "CGL", "CHSL"
  isActive  Boolean  @default(true)
  
  questions Question[]
  sourcePdfs SourcePdf[]
  studyPlans       StudyPlan[]

  @@map("exams")
}

model Subject {
  id        String    @id @default(uuid())
  name      String    @unique // e.g. "Reasoning", "Quantitative Aptitude"
  slug      String    @unique
  chapters  Chapter[]
  questions Question[]
  sourcePdfs SourcePdf[]
  studyPlans       StudyPlan[]

  @@map("subjects")
}

model Chapter {
  id        String     @id @default(uuid())
  subjectId String
  name      String
  slug      String
  topics    Topic[]
  questions Question[]
  weakTopicReports WeakTopicReport[]
  purchases ChapterPurchase[]

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, slug])
  @@map("chapters")
}

model Topic {
  id        String     @id @default(uuid())
  chapterId String
  name      String
  slug      String
  subTopics SubTopic[]
  questions Question[]

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, slug])
  @@map("topics")
}

model SubTopic {
  id        String     @id @default(uuid())
  topicId   String
  name      String
  slug      String
  questions Question[]

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("sub_topics")
}

// ================= PDF IMPORT & QUESTION PIPELINE =================

model SourcePdf {
  id               String        @id @default(uuid())
  filename         String
  originalUrl      String
  fileSize         Int
  uploadedByUserId String
  
  subjectId        String?
  examId           String?
  bookName         String?
  publisher        String?
  language         String        @default("Hindi/English")
  year             Int?
  shift            String?
  paperCode        String?

  createdAt        DateTime      @default(now())

  exam             Exam?         @relation(fields: [examId], references: [id])
  subject          Subject?      @relation(fields: [subjectId], references: [id])
  importBatches    ImportBatch[]
  questions        Question[]

  @@map("source_pdfs")
}

model ImportBatch {
  id              String        @id @default(uuid())
  sourcePdfId     String
  status          ImportStatus  @default(QUEUED)
  totalChunks     Int           @default(0)
  completedChunks Int           @default(0)
  failedChunks    Int           @default(0)
  errorMessage    String?
  
  createdAt       DateTime      @default(now())
  completedAt     DateTime?

  sourcePdf       SourcePdf     @relation(fields: [sourcePdfId], references: [id], onDelete: Cascade)
  chunks          ImportChunk[]
  questions       Question[]

  @@map("import_batches")
}

model ImportChunk {
  id            String      @id @default(uuid())
  importBatchId String
  chunkIndex    Int
  startPage     Int
  endPage       Int
  status        ChunkStatus @default(PENDING)
  errorMessage  String?
  processedAt   DateTime?

  batch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, chunkIndex])
  @@map("import_chunks")
}

model Question {
  id                 String            @id @default(uuid())
  sourcePdfId        String?
  importBatchId      String?
  
  subjectId          String
  chapterId          String?
  topicId            String?
  subTopicId         String?
  examId             String?
  
  year               Int?
  shift              String?
  paperCode          String?

  questionText       String
  questionTextHindi  String?
  optionsJson        Json              // Array of { key: "A", text: "...", isCorrect: boolean }
  correctAnswer      String            // e.g. "A" / "B" / "C" / "D"
  
  explanation        String?
  explanationHindi   String?
  explanationSource  ExplanationSource @default(PDF)
  translationStatus  TranslationStatus @default(HUMAN_VERIFIED)
  answerVerificationStatus String @default("UNVERIFIED_SINGLE_SOURCE") // VERIFIED_OFFICIAL, VERIFIED_MULTI_SOURCE, VERIFIED_COMPUTED, UNVERIFIED_SINGLE_SOURCE, DISPUTED
  lastVerifiedAt DateTime?
  isApproved         Boolean           @default(false)
  
  difficulty         Difficulty        @default(MEDIUM)
  marks              Float             @default(2.0)
  negativeMarks      Float             @default(0.5)
  
  searchHash         String?
  isActive           Boolean           @default(true)

  // v5 §37.4 — Report Error loop: auto soft-suspend after threshold
  errorReportCount   Int               @default(0)
  autoSuspended      Boolean           @default(false)
  suspendedAt        DateTime?

  // Video Solution Fields
  videoUrl           String?
  videoSource        VideoSource?
  videoTitle         String?
  videoDescription   String?
  videoDurationSeconds Int?
  videoLanguage      String?   // e.g. \"Hindi\", \"English\", \"Hinglish\"
  videoUploadedAt    DateTime?
  videoUploadedBy    String?   // userId of admin who added

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  sourcePdf          SourcePdf?        @relation(fields: [sourcePdfId], references: [id])
  importBatch        ImportBatch?      @relation(fields: [importBatchId], references: [id])
  subject            Subject           @relation(fields: [subjectId], references: [id])
  chapter            Chapter?          @relation(fields: [chapterId], references: [id])
  topic              Topic?            @relation(fields: [topicId], references: [id])
  subTopic           SubTopic?         @relation(fields: [subTopicId], references: [id])
  exam               Exam?             @relation(fields: [examId], references: [id])
  
  versions           QuestionVersion[]
  answers            AttemptAnswer[]
  bookmarks          Bookmark[]
  notes              UserNote[]
  reviewCards        ReviewCard[]
  errorReports       QuestionErrorReport[]

  @@index([subjectId, examId, year, shift])
  @@index([searchHash])
  @@index([isApproved, isActive])
  @@index([errorReportCount])
  @@index([examId, subjectId, isApproved, isActive]) // CGL/compose hot path
  @@map("questions")
}

model QuestionVersion {
  id             String   @id @default(uuid())
  questionId     String
  editedByUserId String
  previousText   String
  previousOptions Json
  previousAnswer String
  reason         String?
  createdAt      DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_versions")
}

// ================= TEST ENGINE & ATTEMPTS =================

model TestTemplate {
  id               String        @id @default(uuid())
  title            String
  description      String?
  type             TestType
  durationMinutes  Int           @default(60)
  totalQuestions   Int           @default(100)
  totalMarks       Float         @default(200.0)
  isPremium        Boolean       @default(false)
  isActive         Boolean       @default(true)
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  attempts         TestAttempt[]
  pdfExports       TestPdfExport[]

  @@map("test_templates")
}

// v6 §7 — Test paper + Answer-key PDF export with mandatory 4-pass QA gate.
// PDFs stored as bytea (no volume config needed); binary data never exposed via API JSON.
model TestPdfExport {
  id               String     @id @default(uuid())
  testTemplateId   String     @unique
  testTemplate     TestTemplate @relation(fields: [testTemplateId], references: [id], onDelete: Cascade)

  paperPdf         Bytes?     // test paper (bilingual)
  answerKeyPdf     Bytes?     // answer key + solutions (bilingual)
  questionSnapshot Json?      // canonical QID list at generation time (pass-4 regression diff base)

  // 4-pass QA gate (v6 §7 — sab passes hone par hi publish):
  pass1Field       Boolean    @default(false) // automated: PDF marked-correct === DB correct_index
  pass2Structural  Boolean    @default(false) // automated: PDF option list === live option list 1:1
  pass3SpotCheck   Boolean    @default(false) // admin sampled review
  pass4Regression  Boolean    @default(false) // pre-publish re-compare vs canonical source
  isPublished      Boolean    @default(false)
  publishedAt      DateTime?
  lastGeneratedAt  DateTime?

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("test_pdf_exports")
}

model TestAttempt {
  id               String        @id @default(uuid())
  userId           String
  testTemplateId   String
  status           AttemptStatus @default(IN_PROGRESS)
  
  score            Float         @default(0.0)
  totalCorrect     Int           @default(0)
  totalWrong       Int           @default(0)
  totalSkipped     Int           @default(0)
  accuracyPercent  Float         @default(0.0)
  rank             Int?
  percentile       Float?
  
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  // Server-authoritative deadline: expiresAt = startedAt + template duration.
  // Clients may display a countdown from this, but the server enforces it:
  // a submit after expiresAt is treated as auto-submit at expiry (no extra time).
  expiresAt        DateTime?

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  testTemplate     TestTemplate  @relation(fields: [testTemplateId], references: [id])
  answers          AttemptAnswer[]

  @@index([userId, status])
  @@index([testTemplateId, status]) // rank/percentile + leaderboard hot path
  @@map("test_attempts")
}

model AttemptAnswer {
  id                 String      @id @default(uuid())
  testAttemptId     String
  questionId         String
  selectedOption     String?     // "A", "B", "C", "D" or null if skipped
  isCorrect          Boolean     @default(false)
  timeSpentSeconds   Int         @default(0)
  isMarkedForReview Boolean     @default(false)

  testAttempt TestAttempt @relation(fields: [testAttemptId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id])

  @@unique([testAttemptId, questionId])
  @@map("attempt_answers")
}

// ================= SUBSCRIPTIONS & PAYMENTS =================

model Plan {
  id             String   @id @default(uuid())
  name           String   // e.g. "Monthly Pass (1 Month)", "Super Pass (24 Months)"
  durationMonths Int
  priceInr       Float
  isActive       Boolean  @default(true)

  subscriptions Subscription[]

  @@map("plans")
}

// P2 — discount coupons (percentage or flat), optional single-use per user
model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  description   String?
  discountPct   Float?    // percentage discount (0–100)
  discountInr   Float?    // flat discount in ₹ (mutually exclusive with discountPct)
  maxUses       Int       @default(1)
  usesCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@map("coupons")
}

// P2 — ₹1 chapter PDF purchase (unlocks a chapter's PDF export)
model ChapterPurchase {
  id         String   @id @default(uuid())
  userId     String
  chapterId  String
  amountInr  Float    @default(1.0)
  status     PaymentStatus @default(SUCCESS)
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@map("chapter_purchases")
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId, status])
  @@map("subscriptions")
}

model Payment {
  id               String        @id @default(uuid())
  userId           String
  subscriptionId   String?
  razorpayOrderId  String        @unique
  razorpayPaymentId String?      @unique
  amountInr        Float
  status           PaymentStatus @default(PENDING)
  invoiceUrl       String?
  metadataJson     Json?         // P2: { kind: 'PLAN'|'CHAPTER', planId?, chapterId?, couponCode?, discount }
  createdAt        DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

// ================= USER ACTIVITY & AUDIT =================

model DailyPracticeHistory {
  id                String   @id @default(uuid())
  userId            String
  date              DateTime @db.Date
  questionsAnswered Int      @default(0)
  score             Float    @default(0.0)
  xpEarned          Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_practice_history")
}

model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("bookmarks")
}

model UserNote {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  noteText   String
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("user_notes")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String   // e.g. "USER_LOGIN", "IMPORT_BATCH_CREATED", "QUESTION_EDITED"
  targetEntity String
  entityId     String?
  metadataJson Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ================= REFERRAL =================
// Only PAID purchases by referees count toward a referrer's reward tally.
model Referral {
  id              String   @id @default(uuid())
  referrerId      String
  refereeId       String
  status          ReferralStatus @default(PENDING) // PENDING -> PAID -> REWARDED
  purchasesCount  Int      @default(0) // number of PAID purchases by referee
  rewardedAt      DateTime?
  createdAt       DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([referrerId, refereeId])
  @@index([referrerId])
  @@index([refereeId])
  @@map("referrals")
}

enum ReferralStatus {
  PENDING
  PAIDED
  REWARDED
}

// ================= DAILY QUIZ =================
model DailyQuiz {
  id            String   @id @default(uuid())
  date          DateTime @db.Date
  title         String
  subjectId     String?
  examId        String?
  questionsJson Json     @default("[]") // array of question ids
  createdAt     DateTime @default(now())

  attempts DailyQuizAttempt[]

  @@unique([date])
  @@map("daily_quizzes")
}

model DailyQuizAttempt {
  id            String   @id @default(uuid())
  userId        String
  dailyQuizId   String
  score         Float    @default(0.0)
  totalCorrect  Int      @default(0)
  totalWrong    Int      @default(0)
  totalSkipped  Int      @default(0)
  startedAt     DateTime @default(now())
  submittedAt   DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyQuiz DailyQuiz @relation(fields: [dailyQuizId], references: [id], onDelete: Cascade)

  @@unique([userId, dailyQuizId])
  @@index([userId])
  @@map("daily_quiz_attempts")
}

// ================= WEAK TOPIC ANALYSIS =================
model WeakTopicReport {
  id             String   @id @default(uuid())
  userId         String
  chapterId      String
  subjectId      String
  topicId        String?
  attemptsMade   Int      @default(0)
  correctCount   Int      @default(0)
  accuracyPercent Float   @default(0.0)
  strengthScore  Float    @default(0.0) // 0=weak, 100=strong
  isWeak         Boolean  @default(false)
  maxAttempts    Int      @default(25) // target 25 questions per weak chapter
  updatedAt      DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId, strengthScore])
  @@index([userId, isWeak])
  @@map("weak_topic_reports")
}

// ================= MOCK GATING & PRICING =================
model MockAccess {
  id            String   @id @default(uuid())
  userId        String
  testTemplateId String
  freeMocksAllowed Int   @default(2) // 2 free mocks per test
  mocksUsed     Int      @default(0)
  paidPacksPurchased Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, testTemplateId])
  @@index([userId])
  @@map("mock_accesses")
}

model PricePack {
  id         String   @id @default(uuid())
  name       String   // e.g. "Mock Access Pack", "10-Day Offer"
  examId     String?
  mocksIncluded Int   @default(5)
  priceInr   Float
  durationDays Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("price_packs")
}

// ================= STUDY PLANS (v3 Engine) =================
enum StudyPlanType {
  COMBINED
  SUBJECT_WISE
}

model StudyPlan {
  id              String         @id @default(uuid())
  userId          String
  examId          String
  subjectId       String?
  type            StudyPlanType
  startDate       DateTime       @db.Date
  targetDate      DateTime       @db.Date
  dailyTarget     Int            @default(0) // questions per day
  currentStreak   Int            @default(0)
  longestStreak   Int            @default(0)
  lastPracticeDate DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam            Exam           @relation(fields: [examId], references: [id])
  subject         Subject?       @relation(fields: [subjectId], references: [id])

  @@index([userId])
  @@index([userId, examId])
  @@map("study_plans")
}

// ================= TELEGRAM =================
model TelegramUser {
  id           String   @id @default(uuid())
  userId       String   @unique
  chatId       BigInt   @unique
  username     String?
  firstName    String?
  lastName     String?
  languageCode String?  @default("en")
  isActive     Boolean  @default(true)
  registeredAt DateTime @default(now())
  lastActiveAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptions TelegramSubscription[]

  @@map("telegram_users")
}

model TelegramSubscription {
  id        String   @id @default(uuid())
  userId    String
  chatId    BigInt
  type      String   // "daily_practice", "mock_results", "leaderboard", "announcements"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user TelegramUser @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

  @@unique([chatId, type])
  @@map("telegram_subscriptions")
}

model TelegramBot {
  id            String   @id @default(uuid())
  botToken      String   @unique
  botUsername   String   @unique
  webhookUrl    String?
  isActive      Boolean  @default(true)
  allowedUpdates String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("telegram_bots")
}

// v5 §37.4 — Report Error: students flag suspected wrong answers; auto soft-suspend past threshold
model QuestionErrorReport {
  id          String   @id @default(uuid())
  questionId  String
  userId      String
  description String
  category    ErrorReportCategory @default(OTHER) // v5 §40 — error-type classification
  status      ErrorReportStatus @default(OPEN) // OPEN, REVIEWING, CONFIRMED, REJECTED
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, status])
  @@index([status])
  @@index([category, status])
  @@map("question_error_reports")
}

enum ErrorReportCategory {
  WRONG_ANSWER
  WRONG_OPTION
  WRONG_EXPLANATION
  TRANSLATION
  TYPO
  MISSING_OPTION
  DUPLICATE
  OTHER
}

enum ErrorReportStatus {
  OPEN
  REVIEWING
  CONFIRMED
  REJECTED
}

// v4 §18 / v6 §8 — SearchMiss: user searched and found nothing → demand log
// feeding the PYQ auto-fetch coverage backlog.
model SearchMiss {
  id        String   @id @default(uuid())
  query     String
  exam      String?
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query])
  @@index([createdAt])
  @@map("search_misses")
}
