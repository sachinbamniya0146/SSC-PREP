// SSC Prep Hub — Prisma Database Schema
// Database: PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
  MODERATOR
}

enum Platform {
  WEB
  APP
}

enum TestType {
  CHAPTER
  TOPIC
  SUBJECT
  MINI_MOCK
  FULL_MOCK
  PREVIOUS_YEAR
  SHIFT_WISE
  YEAR_WISE
  CUSTOM
  DAILY_PRACTICE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExplanationSource {
  PDF
  AI_GENERATED
  HUMAN_VERIFIED
}

enum TranslationStatus {
  HUMAN_VERIFIED
  AUTO_UNVERIFIED
}

enum ImportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum ChunkStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  SKIPPED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}
enum ReferralStatus {
  PENDING
  PAIDED
  REWARDED
}

enum StudyPlanType {
  COMBINED
  SUBJECT_WISE
}

// ================= USER & AUTHENTICATION =================

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  phone            String?         @unique
  fullName         String
  passwordHash     String
  role             Role            @default(STUDENT)
  isEmailVerified  Boolean         @default(false)
  avatarUrl        String?
  googleId         String?         @unique

  // Gamification & Daily Streaks
  currentStreak    Int             @default(0)
  longestStreak    Int             @default(0)
  lastPracticeDate DateTime?
  xp               Int             @default(0)
  coins            Int             @default(0)

  // Referral
  referralCode     String?         @unique
  referredByCode   String?
  freeSubFromReferral Boolean      @default(false)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations - IMPLICIT for backup models (matching their implicit relations)
  sessions              DeviceSession[]
  refreshTokens         RefreshToken[]
  subscriptions         Subscription[]
  payments              Payment[]
  testAttempts          TestAttempt[]
  bookmarks             Bookmark[]
  notes                 UserNote[]
  dailyPractices        DailyPracticeHistory[]
  auditLogs             AuditLog[]
  dailyQuizAttempts     DailyQuizAttempt[]
  weakTopicReports      WeakTopicReport[]
  mockAccesses          MockAccess[]
  referralsMade         Referral[]                @relation("Referrer")
  referralsReceived     Referral[]                @relation("Referee")
  studyPlans            StudyPlan[]
  
  // New model relations (explicit names needed)
  reviewCards           ReviewCard[]              @relation("ReviewCard_User")
  questionErrorReports  QuestionErrorReport[]     @relation("QuestionErrorReport_User")
  achievements          UserAchievement[]         @relation("UserAchievement_User")
  telegramUser          TelegramUser?             @relation("TelegramUser_User")
  telegramSubscriptions TelegramSubscription[]    @relation("TelegramSubscription_User")
  chapterPurchases      ChapterPurchase[]         @relation("ChapterPurchase_User")
  searchMisses          SearchMiss[]              @relation("SearchMiss_User")
  coupons               Coupon[]                  @relation("Coupon_CreatedBy")
  hintQuota             Int                       @default(3)
  friends               Friend[]                  @relation("User_Friends")
  friendOf              Friend[]                  @relation("User_FriendOf")
  sentFriendRequests    FriendRequest[]           @relation("User_SentFriendRequests")
  receivedFriendRequests FriendRequest[]          @relation("User_ReceivedFriendRequests")
  testPdfExports       TestPdfExport[] @relation("TestPdfExport_User")
  testAttemptStats     TestAttemptStats[] @relation("TestAttemptStats_User")

  @@map("users")
}

model DeviceSession {
  id           String   @id @default(uuid())
  userId       String
  platform     Platform
  deviceId     String
  ipAddress    String?
  userAgent    String?
  location     String?
  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform, isActive])
  @@map("device_sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Exam {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "SSC CGL", "SSC CHSL"
  slug      String   @unique
  code      String   @unique // e.g. "CGL", "CHSL"
  isActive  Boolean  @default(true)
  
  questions Question[]
  sourcePdfs SourcePdf[]
  studyPlans       StudyPlan[]
  testTemplates    TestTemplate[] @relation("Exam_TestTemplates")
  chapterPurchases ChapterPurchase[] @relation("ChapterPurchase_Exam")
  patterns         ExamPattern[] @relation("ExamPattern_Exam")
  subjects         Subject[] @relation("Exam_Subjects")

  @@map("exams")
}

model Subject {
  id        String    @id @default(uuid())
  name      String    // e.g. "Reasoning", "Quantitative Aptitude"
  slug      String    @unique
  chapters  Chapter[]
  questions Question[]
  sourcePdfs SourcePdf[]
  studyPlans       StudyPlan[]
  exams            Exam[] @relation("Exam_Subjects")

  @@map("subjects")
}

model Chapter {
  id        String     @id @default(uuid())
  subjectId String
  name      String
  slug      String
  topics    Topic[]
  questions Question[]
  weakTopicReports WeakTopicReport[]
  chapterPurchases ChapterPurchase[] @relation("ChapterPurchase_Chapter")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, slug])
  @@map("chapters")
}

model Topic {
  id        String     @id @default(uuid())
  chapterId String
  name      String
  slug      String
  subTopics SubTopic[]
  questions Question[]

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, slug])
  @@map("topics")
}

model SubTopic {
  id        String     @id @default(uuid())
  topicId   String
  name      String
  slug      String
  questions Question[]

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("sub_topics")
}

model SourcePdf {
  id               String        @id @default(uuid())
  filename         String
  originalUrl      String
  fileSize         Int
  uploadedByUserId String
  
  subjectId        String?
  examId           String?
  bookName         String?
  publisher        String?
  language         String        @default("Hindi/English")
  year             Int?
  shift            String?
  paperCode        String?

  createdAt        DateTime      @default(now())

  exam             Exam?         @relation(fields: [examId], references: [id])
  subject          Subject?      @relation(fields: [subjectId], references: [id])
  importBatches    ImportBatch[]
  questions        Question[]

  @@map("source_pdfs")
}

model ImportBatch {
  id              String        @id @default(uuid())
  sourcePdfId     String
  status          ImportStatus  @default(QUEUED)
  totalChunks     Int           @default(0)
  completedChunks Int           @default(0)
  failedChunks    Int           @default(0)
  errorMessage    String?
  
  createdAt       DateTime      @default(now())
  completedAt     DateTime?

  sourcePdf       SourcePdf     @relation(fields: [sourcePdfId], references: [id], onDelete: Cascade)
  chunks          ImportChunk[]
  questions       Question[]

  @@map("import_batches")
}

model ImportChunk {
  id            String      @id @default(uuid())
  importBatchId String
  chunkIndex    Int
  startPage     Int
  endPage       Int
  status        ChunkStatus @default(PENDING)
  errorMessage  String?
  processedAt   DateTime?

  batch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, chunkIndex])
  @@map("import_chunks")
}

model Question {
  id                 String            @id @default(uuid())
  sourcePdfId        String?
  importBatchId      String?
  
  subjectId          String
  chapterId          String?
  topicId            String?
  subTopicId         String?
  examId             String?
  
  year               Int?
  shift              String?
  paperCode          String?

  questionText       String
  questionTextHindi  String?
  optionsJson        Json              // Array of { key: "A", text: "...", isCorrect: boolean }
  correctAnswer      String            // e.g. "A" / "B" / "C" / "D"
  
  explanation        String?
  explanationHindi   String?
  explanationSource  ExplanationSource @default(PDF)
  translationStatus  TranslationStatus @default(HUMAN_VERIFIED)
  answerVerificationStatus String @default("UNVERIFIED_SINGLE_SOURCE") // VERIFIED_OFFICIAL, VERIFIED_MULTI_SOURCE, VERIFIED_COMPUTED, UNVERIFIED_SINGLE_SOURCE, DISPUTED
  lastVerifiedAt DateTime?
  isApproved         Boolean           @default(false)
  
  difficulty         Difficulty        @default(MEDIUM)
  marks              Float             @default(2.0)
  negativeMarks      Float             @default(0.5)
  
  searchHash         String?
  isActive           Boolean           @default(true)

  // Video solution fields
  videoUrl           String?
  videoSource        String?
  videoTitle         String?
  videoDescription   String?
  videoDurationSeconds Int?
  videoLanguage      String?
  videoUploadedAt    DateTime?
  videoUploadedBy    String?

  // Review/verification fields
  reviewStatus       String?
  aiConfidenceScore  Float?
  verificationEvidence Json?
  autoSuspended      Boolean           @default(false)
  suspendedAt        DateTime?
  errorReportCount   Int               @default(0)

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  sourcePdf          SourcePdf?        @relation(fields: [sourcePdfId], references: [id])
  importBatch        ImportBatch?      @relation(fields: [importBatchId], references: [id])
  subject            Subject           @relation(fields: [subjectId], references: [id])
  chapter            Chapter?          @relation(fields: [chapterId], references: [id])
  topic              Topic?            @relation(fields: [topicId], references: [id])
  subTopic           SubTopic?         @relation(fields: [subTopicId], references: [id])
  exam               Exam?             @relation(fields: [examId], references: [id])
  
  versions           QuestionVersion[]
  answers            AttemptAnswer[]
  bookmarks          Bookmark[]
  notes              UserNote[]
  
  // New model relations
  reviewCards            ReviewCard[]              @relation("ReviewCard_Question")
  questionErrorReports   QuestionErrorReport[]     @relation("QuestionErrorReport_Question")
  chapterPurchases       ChapterPurchase[]         @relation("ChapterPurchase_Question")

  @@index([subjectId, examId, year, shift])
  @@index([searchHash])
  @@index([isApproved, isActive])
  @@map("questions")
}

model QuestionVersion {
  id             String   @id @default(uuid())
  questionId     String
  editedByUserId String
  previousText   String
  previousOptions Json
  previousAnswer String
  reason         String?
  createdAt      DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_versions")
}

model TestTemplate {
  id               String        @id @default(uuid())
  title            String
  description      String?
  type             TestType
  durationMinutes  Int           @default(60)
  totalQuestions   Int           @default(100)
  totalMarks       Float         @default(200.0)
  isPremium        Boolean       @default(false)
  isActive         Boolean       @default(true)
  examId           String?
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  exam             Exam?         @relation("Exam_TestTemplates", fields: [examId], references: [id])
  attempts         TestAttempt[]
  mockAccesses     MockAccess[]
  attemptStats      TestAttemptStats[] @relation("TestAttemptStats_TestTemplate")

  @@unique([examId, title])
  @@map("test_templates")
}

model TestAttempt {
  id               String        @id @default(uuid())
  userId           String
  testTemplateId   String
  status           AttemptStatus @default(IN_PROGRESS)
  
  score            Float         @default(0.0)
  totalCorrect     Int           @default(0)
  totalWrong       Int           @default(0)
  totalSkipped     Int           @default(0)
  accuracyPercent  Float         @default(0.0)
  rank             Int?
  percentile       Float?
  
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  timeTakenSeconds Int?
  questionSnapshot Json?
  expiresAt        DateTime?

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  testTemplate     TestTemplate  @relation(fields: [testTemplateId], references: [id])
  answers          AttemptAnswer[]
  testPdfExport      TestPdfExport? @relation("TestPdfExport_TestAttempt")
  attemptStats       TestAttemptStats? @relation("TestAttemptStats_TestAttempt")

  @@index([userId, status])
  @@map("test_attempts")
}

model AttemptAnswer {
  id                 String      @id @default(uuid())
  testAttemptId     String
  questionId         String
  selectedOption     String?     // "A", "B", "C", "D" or null if skipped
  isCorrect          Boolean     @default(false)
  timeSpentSeconds   Int         @default(0)
  isMarkedForReview Boolean     @default(false)

  testAttempt TestAttempt @relation(fields: [testAttemptId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id])

  @@unique([testAttemptId, questionId])
  @@map("attempt_answers")
}

model Plan {
  id             String   @id @default(uuid())
  code           String   @unique // e.g. "MONTHLY", "SUPER_PASS_24M", "ADMIN_GRANTED"
  name           String   // e.g. "Monthly Pass (1 Month)", "Super Pass (24 Months)"
  description    String?
  durationMonths Int
  priceInr       Float
  isActive       Boolean  @default(true)
  features       String[] @default([])

  subscriptions          Subscription[]
  telegramSubscriptions  TelegramSubscription[] @relation("TelegramSubscription_Plan")

  @@map("plans")
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId, status])
  @@unique([userId, planId])
  @@map("subscriptions")
}

model Payment {
  id               String        @id @default(uuid())
  userId           String
  subscriptionId   String?
  razorpayOrderId  String        @unique
  razorpayPaymentId String?      @unique
  amountInr        Float
  status           PaymentStatus @default(PENDING)
  invoiceUrl       String?
  createdAt        DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

model DailyPracticeHistory {
  id                String   @id @default(uuid())
  userId            String
  date              DateTime @db.Date
  questionsAnswered Int      @default(0)
  score             Float    @default(0.0)
  xpEarned          Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_practice_history")
}

model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("bookmarks")
}

model UserNote {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  noteText   String
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("user_notes")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String   // e.g. "USER_LOGIN", "IMPORT_BATCH_CREATED", "QUESTION_EDITED"
  targetEntity String
  entityId     String?
  metadataJson Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Referral {
  id              String   @id @default(uuid())
  referrerId      String
  refereeId       String
  status          ReferralStatus @default(PENDING) // PENDING -> PAID -> REWARDED
  purchasesCount  Int      @default(0) // number of PAID purchases by referee
  rewardedAt      DateTime?
  createdAt       DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([referrerId, refereeId])
  @@index([referrerId])
  @@index([refereeId])
  @@map("referrals")
}

model DailyQuiz {
  id            String   @id @default(uuid())
  date          DateTime @db.Date
  title         String
  subjectId     String?
  examId        String?
  questionsJson Json     @default("[]") // array of question ids
  createdAt     DateTime @default(now())

  attempts DailyQuizAttempt[]

  @@unique([date])
  @@map("daily_quizzes")
}

model DailyQuizAttempt {
  id            String   @id @default(uuid())
  userId        String
  dailyQuizId   String
  score         Float    @default(0.0)
  totalCorrect  Int      @default(0)
  totalWrong    Int      @default(0)
  totalSkipped  Int      @default(0)
  startedAt     DateTime @default(now())
  submittedAt   DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyQuiz DailyQuiz @relation(fields: [dailyQuizId], references: [id], onDelete: Cascade)

  @@unique([userId, dailyQuizId])
  @@index([userId])
  @@map("daily_quiz_attempts")
}

model WeakTopicReport {
  id             String   @id @default(uuid())
  userId         String
  chapterId      String
  subjectId      String
  topicId        String?
  attemptsMade   Int      @default(0)
  correctCount   Int      @default(0)
  accuracyPercent Float   @default(0.0)
  strengthScore  Float    @default(0.0) // 0=weak, 100=strong
  isWeak         Boolean  @default(false)
  maxAttempts    Int      @default(25) // target 25 questions per weak chapter
  updatedAt      DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId, strengthScore])
  @@index([userId, isWeak])
  @@map("weak_topic_reports")
}

model MockAccess {
  id            String   @id @default(uuid())
  userId        String
  testTemplateId String
  freeMocksAllowed Int   @default(2) // 2 free mocks per test
  mocksUsed     Int      @default(0)
  paidPacksPurchased Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  testTemplate TestTemplate @relation(fields: [testTemplateId], references: [id])

  @@unique([userId, testTemplateId])
  @@index([userId])
  @@map("mock_accesses")
}

model PricePack {
  id         String   @id @default(uuid())
  name       String   // e.g. "Mock Access Pack", "10-Day Offer"
  examId     String?
  mocksIncluded Int   @default(5)
  priceInr   Float
  durationDays Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("price_packs")
}

model StudyPlan {
  id              String         @id @default(uuid())
  userId          String
  examId          String
  subjectId       String?
  type            StudyPlanType
  startDate       DateTime       @db.Date
  targetDate      DateTime       @db.Date
  dailyTarget     Int            @default(0) // questions per day
  currentStreak   Int            @default(0)
  longestStreak   Int            @default(0)
  lastPracticeDate DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam            Exam           @relation(fields: [examId], references: [id])
  subject         Subject?       @relation(fields: [subjectId], references: [id])

  @@index([userId])
  @@index([userId, examId])
  @@map("study_plans")
}


enum ErrorReportStatus {
  OPEN
  REVIEWING
  CONFIRMED
  REJECTED
}

enum AchievementType {
  STREAK_DAYS
  XP_MILESTONE
  TESTS_COMPLETED
  ACCURACY_MASTER
  QUESTIONS_ANSWERED
  DAILY_QUIZ_STREAK
  MOCK_RANK
  REFERRAL
  SPECIAL
}

enum AchievementTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_INR
}

enum ChapterPurchaseStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}


model ReviewCard {
  id            String   @id @default(uuid())
  userId        String
  questionId    String
  easeFactor    Float    @default(2.5)
  repetitions   Int      @default(0)
  intervalDays  Int      @default(1)
  dueAt         DateTime @default(now())
  lapses        Int      @default(0)
  suspended     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation("ReviewCard_User", fields: [userId], references: [id], map: "review_card_user_fkey")
  question      Question @relation("ReviewCard_Question", fields: [questionId], references: [id], map: "review_card_question_fkey")

  @@unique([userId, questionId], map: "review_card_user_question_key")
  @@index([userId])
  @@index([questionId])
  @@index([dueAt])
  @@map("review_cards")
}

model Coupon {
  id              String            @id @default(uuid())
  code            String            @unique(map: "coupon_code_key")
  description     String?
  discountType    CouponDiscountType @default(PERCENTAGE)
  discountPct     Float?
  discountInr     Float?
  maxUses         Int?
  usesCount       Int               @default(0)
  expiresAt       DateTime?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdById     String?
  createdBy       User?             @relation("Coupon_CreatedBy", fields: [createdById], references: [id], map: "coupon_created_by_fkey")
  chapterPurchases ChapterPurchase[] @relation("ChapterPurchase_Coupon")

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model QuestionErrorReport {
  id           String           @id @default(uuid())
  userId       String
  questionId   String
  description  String
  category     String           @default("OTHER")
  status       ErrorReportStatus @default(OPEN)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  resolvedAt   DateTime?
  resolvedBy   String?

  user         User             @relation("QuestionErrorReport_User", fields: [userId], references: [id], map: "question_error_report_user_fkey")
  question     Question         @relation("QuestionErrorReport_Question", fields: [questionId], references: [id], map: "question_error_report_question_fkey")

  @@index([userId])
  @@index([questionId])
  @@index([status])
  @@map("question_error_reports")
}

model Achievement {
  id              String          @id @default(uuid())
  type            AchievementType
  key             String          @unique(map: "achievement_key_key")
  name            String
  nameHindi       String?
  description     String?
  descriptionHindi String?
  icon            String
  tier            AchievementTier
  criteria        Json
  xpReward        Int             @default(0)
  coinReward      Int             @default(0)
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  userAchievements UserAchievement[] @relation("Achievement_UserAchievement")

  @@index([type])
  @@index([isActive])
  @@map("achievements")
}

model UserAchievement {
  id            String       @id @default(uuid())
  userId        String
  achievementId String
  earnedAt      DateTime     @default(now())

  user          User         @relation("UserAchievement_User", fields: [userId], references: [id], map: "user_achievement_user_fkey")
  achievement   Achievement  @relation("Achievement_UserAchievement", fields: [achievementId], references: [id], map: "user_achievement_achievement_fkey")

  @@unique([userId, achievementId], map: "user_achievement_user_achievement_key")
  @@index([userId])
  @@map("user_achievements")
}

model Friend {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("User_Friends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("User_FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@map("friends")
}

model FriendRequest {
  id        String              @id @default(uuid())
  senderId  String
  receiverId String
  status    FriendRequestStatus @default(PENDING)
  message   String?
  respondedAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  sender  User @relation("User_SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("User_ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@map("friend_requests")
}

model TelegramUser {
  id            String   @id @default(uuid())
  userId        String   @unique(map: "telegram_user_user_id_key")
  chatId        BigInt   @unique(map: "telegram_user_chat_id_key")
  username      String?
  firstName     String?
  lastName      String?
  languageCode  String?  @default("en")
  isActive      Boolean  @default(true)
  lastActiveAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation("TelegramUser_User", fields: [userId], references: [id], map: "telegram_user_user_fkey")
  subscriptions TelegramSubscription[] @relation("TelegramSubscription_TelegramUser")

  @@index([userId])
  @@index([chatId])
  @@map("telegram_users")
}

model TelegramSubscription {
  id              String   @id @default(uuid())
  userId          String
  chatId          BigInt
  type            String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation("TelegramSubscription_User", fields: [userId], references: [id], map: "telegram_subscription_user_fkey")
  plan            Plan?    @relation("TelegramSubscription_Plan", fields: [planId], references: [id], map: "telegram_subscription_plan_fkey")
  telegramUser    TelegramUser? @relation("TelegramSubscription_TelegramUser", fields: [chatId], references: [chatId], map: "telegram_subscription_telegram_user_fkey")
  planId          String?

  @@unique([chatId, type], map: "telegram_subscription_chat_type_key")
  @@index([userId])
  @@index([chatId])
  @@index([type])
  @@map("telegram_subscriptions")
}

model ChapterPurchase {
  id            String               @id @default(uuid())
  userId        String
  chapterId     String
  examId        String
  questionId    String?
  amountInr     Float
  discountInr   Float?               @default(0)
  couponCode    String?
  status        ChapterPurchaseStatus @default(PENDING)
  paymentId     String?
  razorpayOrderId String?
  razorpayPaymentId String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  completedAt   DateTime?

  user          User                 @relation("ChapterPurchase_User", fields: [userId], references: [id], map: "chapter_purchase_user_fkey")
  chapter       Chapter              @relation("ChapterPurchase_Chapter", fields: [chapterId], references: [id], map: "chapter_purchase_chapter_fkey")
  exam          Exam                 @relation("ChapterPurchase_Exam", fields: [examId], references: [id], map: "chapter_purchase_exam_fkey")
  question      Question?            @relation("ChapterPurchase_Question", fields: [questionId], references: [id], map: "chapter_purchase_question_fkey")
  coupon        Coupon?              @relation("ChapterPurchase_Coupon", fields: [couponCode], references: [code], map: "chapter_purchase_coupon_fkey")

  @@unique([userId, chapterId], map: "chapter_purchase_user_chapter_key")
  @@index([userId])
  @@index([chapterId])
  @@index([examId])
  @@index([questionId])
  @@index([status])
  @@map("chapter_purchases")
}

model SearchMiss {
  id            String     @id @default(uuid())
  query         String
  exam          String?
  userId        String?
  user          User?      @relation("SearchMiss_User", fields: [userId], references: [id], map: "search_miss_user_fkey")
  createdAt     DateTime   @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("search_misses")
}

model ExamPattern {
  id               String   @id @default(uuid())
  examId           String
  exam             Exam     @relation("ExamPattern_Exam", fields: [examId], references: [id])
  name             String
  totalQuestions   Int
  totalMarks       Float
  durationMinutes  Int
  negativeMarks    Float
  sections         Json
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([examId])
  @@unique([examId, name])
  @@map("exam_patterns")
}

model TestPdfExport {
  id              String   @id @default(uuid())
  userId          String?
  testAttemptId   String   @unique
  filePath        String?
  fileSize        Int      @default(0)
  status          String   @default("GENERATED")
  paperPdf        String?
  answerKeyPdf    String?
  questionSnapshot Json?
  pass1Field      Boolean  @default(false)
  pass2Structural Boolean  @default(false)
  pass3SpotCheck  Json?
  pass4Regression Boolean  @default(false)
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  lastGeneratedAt DateTime  @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime?

  user        User?       @relation("TestPdfExport_User", fields: [userId], references: [id], onDelete: Cascade)
  testAttempt TestAttempt @relation("TestPdfExport_TestAttempt", fields: [testAttemptId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("test_pdf_exports")
}

model TestAttemptStats {
  id              String   @id @default(uuid())
  userId          String
  testTemplateId  String   @unique
  testAttemptId   String?   @unique
  totalTests      Int      @default(0)
  totalQuestions  Int      @default(0)
  totalCorrect    Int      @default(0)
  totalWrong      Int      @default(0)
  totalSkipped    Int      @default(0)
  avgAccuracy     Float    @default(0.0)
  avgTimePerQ     Float    @default(0.0)
  bestScore       Float    @default(0.0)
  streak          Int      @default(0)
  longestStreak   Int      @default(0)
  lastAttemptAt   DateTime?
  updatedAt       DateTime @updatedAt

  user          User         @relation("TestAttemptStats_User", fields: [userId], references: [id], onDelete: Cascade)
  testTemplate  TestTemplate @relation("TestAttemptStats_TestTemplate", fields: [testTemplateId], references: [id], onDelete: Cascade)
  testAttempt   TestAttempt? @relation("TestAttemptStats_TestAttempt", fields: [testAttemptId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("test_attempt_stats")
}