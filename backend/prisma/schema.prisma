  resolvedAt       DateTime?
  resolvedBy       String?
  firstAdminViewAt DateTime? // set once, first time an admin/moderator posts in the thread (OPEN -> REVIEWING)
  fixedNotifiedAt  DateTime? // NEW (Oct 3 2026): admin fixed the question and the student got the thank-you message
