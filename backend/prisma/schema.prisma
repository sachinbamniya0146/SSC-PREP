// ================= AI API KEYS =================
// Admin-managed API keys for different AI providers
model AdminApiKey {
  id           String   @id @default(uuid())
  provider     String // e.g., "openrouter", "openai", "gemini"
  keyName      String // e.g., "OpenRouter - GPT-4o-mini"
  apiKey       String // Encrypted API key
  isActive     Boolean  @default(true)
  isPrimary    Boolean  @default(false) // Only one primary key per provider
  freeModelOnly Boolean @default(false) // Only use free models if true
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String? // Admin user ID

  // --- Rotation / health tracking (bulk-key pool support) ---
  // A provider can have many keys added at once (bulk upload). Requests
  // rotate across all isActive=true keys for that provider (isPrimary
  // first, then least-recently-used) instead of only ever using one key.
  usageCount     Int       @default(0) // successful calls served by this key
  failureCount   Int       @default(0) // failed calls (any reason)
  lastUsedAt     DateTime? // used to pick the least-recently-used key next
  lastFailureAt  DateTime?
  lastErrorMessage String? // most recent provider error (quota/invalid/etc.)
  exhaustedAt    DateTime? // set when auto-disabled after a quota/auth failure
                           // (distinct from an admin manually toggling isActive)

  @@index([provider, isActive])
  @@map("admin_api_keys")
}

// Raised automatically when the admin API key pool is running low, so the
// admin can add a new key BEFORE every key in the pool is exhausted rather
// than finding out only after AI features stop working for everyone.
model AdminAlert {
  id           String    @id @default(uuid())
  type         String // "API_KEY_LOW" | "API_KEY_EXHAUSTED" | "API_KEY_ALL_EXHAUSTED"
  severity     String    @default("WARNING") // INFO | WARNING | CRITICAL
  message      String
  messageHindi String?
  metadataJson Json?
  isResolved   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([isResolved, type])
  @@map("admin_alerts")
}


// =============================================================================
// VOCABULARY MASTERY (NEW — Sep 2026)
//
// "vocabulary ka padhne ka button jisme vocabulary ke questions test practice
// bhi rahenge... ek ek word ka pura revision... uske baad usi word ka quiz...
// 95% sahi kare tab hi complete mark lage, jab tak agla word test nahi khulega":
// a strictly sequential word-mastery track. Deliberately its own small set of
// tables rather than reusing Subject/Chapter/Topic/Question — a vocab word's
// content shape (etymology, memory trick, synonym/antonym lists with their
// own example sentences) doesn't fit the exam-question schema at all, and the
// unlock-by-mastery workflow (95% gate, sequential, force-unlockable with a
// ₹10 payment) has no equivalent anywhere else in the app.
// =============================================================================

model VocabWord {
  id                String   @id @default(uuid())
  slug              String   @unique
  word              String
  // 1, 2, 3... — the mastery sequence. Word 1 is always unlocked; finishing
  // word N with >=95% is what unlocks word N+1 (see VocabWordProgress).
  orderIndex        Int
  partOfSpeech      String?
  pronunciation     String?
  meaningHindi      String
  meaningEnglish    String
  memoryTrick       String?  @db.Text
  etymology         String?  @db.Text
  registerNote      String?  @db.Text
  examTrendNote     String?  @db.Text
  confusingPairNote String?  @db.Text
  examplesJson      Json?    // [{ en: string, hi: string }]
  synonymsJson      Json?    // [{ word: string, hindi: string, sentence: string }]
  antonymsJson      Json?    // same shape as synonymsJson
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  questions VocabQuestion[]
  progress  VocabWordProgress[]
  purchases VocabWordPurchase[]

  @@index([orderIndex])
  @@map("vocab_words")
}

model VocabQuestion {
  id            String   @id @default(uuid())
  wordId        String
  questionText  String   @db.Text
  optionsJson   Json     // [{ key: "A", text: "..." }, ...]
  correctAnswer String   // "A" | "B" | "C" | "D"
  explanation   String?  @db.Text
  questionType  String?  // SYNONYM | ANTONYM | CONTEXT — informational only
  createdAt     DateTime @default(now())

  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@map("vocab_questions")
}

// One row per (user, word). Absence of a row = LOCKED and never attempted.
model VocabWordProgress {
  id             String    @id @default(uuid())
  userId         String
  wordId         String
  // No "status" column on purpose — LOCKED / UNLOCKED / MASTERED is always
  // DERIVED (see VocabService.computeStates()): MASTERED = masteredAt is
  // set; UNLOCKED = the first word, OR the previous word's masteredAt is
  // set, OR forceUnlocked; otherwise LOCKED. Storing it as a second,
  // separately-updated column would risk it drifting out of sync with the
  // masteredAt/forceUnlocked facts that actually define it.
  bestScorePct   Int       @default(0)
  attemptsCount  Int       @default(0)
  // Wrong-answer count on the MOST RECENT attempt (pass or fail) — a
  // mastered word with lastWrongCount > 0 is surfaced in "Aaj ka Revision"
  // (see VocabService.todaysPlan()) even though it's already unlocked the
  // next word.
  lastWrongCount Int       @default(0)
  masteredAt     DateTime?
  // Set true by a successful ₹10 VocabWordPurchase — lets a student jump
  // ahead to this specific word without mastering everything before it.
  forceUnlocked  Boolean   @default(false)
  // NEW (Sep 29 2026 — Daily Revision): set true when the student answers a
  // question of this word wrong in the daily revision test. Until they
  // re-score >=95% on this word's own quiz, new (unmastered) words stay
  // locked. Cleared by VocabService.submitQuiz() on a >=95% pass.
  remasterRequired Boolean  @default(false)
  lastRevisedAt  DateTime?
  updatedAt      DateTime  @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, masteredAt])
  @@map("vocab_word_progress")
}

// One row per user — how many NEW words they want to master per day. Purely
// a target/reminder (unlock is still strictly sequential); used to size
// "Aaj ka Plan" on the vocabulary dashboard.
model VocabDailyGoal {
  id          String   @id @default(uuid())
  userId      String   @unique
  wordsPerDay Int      @default(1)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vocab_daily_goals")
}

// "force unlock karne ke liye 10 rs dene honge" — same shape as
// ChapterPurchase, reusing MonetizationService's existing Cashfree order/
// verify/webhook pipeline (see createOrder()'s `vocabWordId` branch) rather
// than a new payment integration.
model VocabWordPurchase {
  id        String        @id @default(uuid())
  userId    String
  wordId    String
  amountInr Float         @default(10)
  status    PaymentStatus @default(SUCCESS)
  createdAt DateTime      @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@map("vocab_word_purchases")
}

// "students chahta hai ki ye words unlock ho to usko 10rs per month dene
// honge... ye vocab ka alag subscription rahe": a dedicated recurring
// subscription (₹10/month) that — while active — treats every vocabulary
// word as UNLOCKED regardless of sequential mastery (see
// VocabService.loadWordsWithProgress()). This REPLACES the earlier
// one-off ₹10-per-word VocabWordPurchase flow as the intended path (that
// table/flow is left in place, unused, rather than migrated away — it's
// harmless dead code, and removing a table is a riskier migration than
// leaving it idle).
model VocabSubscription {
  id        String        @id @default(uuid())
  userId    String        @unique
  startsAt  DateTime      @default(now())
  expiresAt DateTime
  amountInr Float         @default(10)
  status    PaymentStatus @default(SUCCESS)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("vocab_subscriptions")
}

// ================= WEB PUSH NOTIFICATIONS =================
// One row per browser/device subscription a user has granted notification
// permission on (a student can have several: phone + laptop, etc). Admin
// broadcast (POST /push/admin/broadcast) sends to every row here.
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}


// =============================================================================
// VOCAB v2 (Sep 29 2026) — daily revision, escalating skip fee, unlock-all
// =============================================================================

// One row per user: pay-to-skip bookkeeping + the one-time "unlock every
// word" purchase (Rs 100). Kept separate from VocabWordProgress because these
// facts belong to the student, not to any single word.
// Oct 2026 — remembers each student's unlock/mastery of a word that was HARD-deleted, keyed by the word text,
// so re-uploading the same word gives it back unlocked (see src/vocab/vocab-unlock-memory.ts).
model VocabProgressArchive {
  id               String    @id @default(uuid())
  userId           String
  wordKey          String
  bestScorePct     Int       @default(0)
  attemptsCount    Int       @default(0)
  lastWrongCount   Int       @default(0)
  masteredAt       DateTime?
  forceUnlocked    Boolean   @default(true)
  remasterRequired Boolean   @default(false)
  archivedAt       DateTime  @default(now())

  @@unique([userId, wordKey])
  @@index([wordKey])
  @@map("vocab_progress_archive")
}

model VocabUserState {
  id                   String    @id @default(uuid())
  userId               String    @unique
  // Set by a successful VOCAB_UNLOCK_ALL payment -> every word UNLOCKED.
  allUnlockedAt        DateTime?
  // Consecutive daily-revision skips paid for. Drives the escalating fee
  // (Rs 1, 5, 10, ...). Reset to 0 the moment a revision test is completed.
  skipStreak           Int       @default(0)
  lastSkipDateKey      String?   // IST YYYY-MM-DD of the last paid skip
  totalSkipPaidInr     Float     @default(0)
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vocab_user_states")
}

// One row per daily-revision attempt (a student may retry a timed-out one).
// status: IN_PROGRESS | COMPLETED | EXPIRED | SKIPPED
model VocabRevisionSession {
  id             String    @id @default(uuid())
  userId         String
  dateKey        String    // IST YYYY-MM-DD the session belongs to
  status         String    @default("IN_PROGRESS")
  wordIds        Json      // string[] — words covered
  questionIds    Json      // string[] — ordered VocabQuestion ids
  totalQuestions Int       @default(0)
  correctCount   Int       @default(0)
  scorePct       Int       @default(0)
  wrongWordIds   Json?     // string[] — words that need a 95% re-master
  timeLimitSec   Int       @default(0)
  skipFeeInr     Float?    // only for SKIPPED sessions
  startedAt      DateTime  @default(now())
  expiresAt      DateTime
  completedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateKey])
  @@index([userId, status])
  @@map("vocab_revision_sessions")
}

// =============================================================================
// STUDY PLAN v2 (Sep 29 2026) — chapter self-marking + scheduled 9 AM test
// =============================================================================

// A student's own progress on a chapter. Keyed per user (not per plan) —
// knowing a chapter is a fact about the student, it should survive the
// student re-creating their plan for another exam.
// status: PENDING | SELF_MARKED | COMPLETE | WEAK
//   SELF_MARKED = student says "I finished this" (test scheduled to verify)
//   COMPLETE    = verified >=90% in a test / practice
//   WEAK        = tested below 90% -> back to practice
model StudyPlanChapter {
  id           String    @id @default(uuid())
  userId       String
  chapterId    String
  status       String    @default("PENDING")
  selfMarkedAt DateTime?
  lastScorePct Int?
  lastTestedAt DateTime?
  completedAt  DateTime?
  // NEW (Oct 3 2026) — daily revision tracking
  lastRevisedAt DateTime?
  revisionCount Int      @default(0)
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId, status])
  @@map("study_plan_chapters")
}

// The customised full-pattern test built from the chapters a student marked
// complete. Scheduled for 9:00 AM IST the next day; questions are composed
// when the student presses Start (so a late start still gets a fresh paper),
// then snapshotted on the TestAttempt like the Daily Test does.
// status: SCHEDULED | IN_PROGRESS | SUBMITTED | MISSED
model StudyPlanTest {
  id           String    @id @default(uuid())
  userId       String
  examId       String
  scheduledFor DateTime
  chapterIds   Json      // string[] — chapters this test covers
  status       String    @default("SCHEDULED")
  // NEW (Oct 3 2026): TEST = the 9 AM chapter test, REVISION = the mandatory daily 50-question revision
  kind         String    @default("TEST")
  reminderSentAt DateTime? // 8:30 AM email sent
  attemptId    String?   @unique
  scorePct     Int?
  resultJson   Json?     // [{ chapterId, name, correct, total, pct, status }]
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  submittedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, scheduledFor])
  @@index([kind, scheduledFor])
  @@map("study_plan_tests")
}


// ================= AI SOLUTION VERIFICATION (Oct 2026) =================
// A student can confirm ("correct") or dispute ("incorrect") the AI-generated
// solution of a question. One vote per (question, student) — changing your mind
// just updates the row. An AI solution stays labelled "AI generated" and is
// shown to every student who has not voted yet until at least 10 DISTINCT
// students confirmed it; then it is saved permanently (COMMUNITY_VERIFIED).
model ExplanationVote {
  id         String   @id @default(uuid())
  questionId String
  userId     String
  vote       String   // CORRECT | INCORRECT
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([questionId, vote])
  @@map("explanation_votes")
}

// ================= AI KEY USAGE LOG (NEW Oct 7 2026) =================
// One row per AI request attempt, so the admin can see for EVERY OpenRouter key
// which feature used it, when, with which free model and whether it worked.
// No foreign key on purpose: the history must survive a deleted key.
model AiUsageLog {
  id           String   @id @default(uuid())
  keyId        String?  // AdminApiKey.id (null = a student's own key)
  keyName      String   // snapshot of the key name at that moment
  feature      String   // e.g. PYQ_DATE_MAPPING | AI_EXPLANATION | QUESTION_EDIT_AI | PDF_INGESTION | KEY_TEST
  model        String?  // free model that answered (null when the attempt failed)
  success      Boolean
  errorMessage String?
  latencyMs    Int?
  createdAt    DateTime @default(now())

  @@index([keyId, createdAt])
  @@index([feature, createdAt])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

// ================= PYQ DATE MAPPING (NEW Oct 7 2026) =================
// One row per PYQ question that the date-mapping worker looks at. The worker searches
// the internet for the question, asks a FREE OpenRouter model to read the evidence
// (5 independent passes) and only when enough passes agree - and the date's year equals
// the question's year - the date is written to Question.examDate.
model PyqDateMap {
  id            String    @id @default(uuid())
  questionId    String    @unique
  // PENDING | RUNNING | MAPPED | NEEDS_REVIEW | NOT_FOUND | FAILED | MANUAL
  status        String    @default("PENDING")
  examTier      String?   // TIER_1 | TIER_2
  proposedDate  String?   // YYYY-MM-DD voted by the passes (even when not applied)
  proposedYear  Int?
  agreeCount    Int       @default(0)
  passesDone    Int       @default(0)
  confidence    Float?    // 0-1
  note          String?   // human readable reason (why review / why not found)
  passesJson    Json?     // full detail of every pass (query, sources, model, answer, verdict)
  sourcesJson   Json?     // best source urls
  attempts      Int       @default(0)
  lastError     String?
  verifyExisting Boolean  @default(false) // question already had a date: only check it, never overwrite
  nextRunAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  appliedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([updatedAt])
  @@map("pyq_date_maps")
}

// Single row (id = "default") with the worker settings the admin can change from the UI.
model PyqDateConfig {
  id             String    @id @default("default")
  autoRun        Boolean   @default(true)
  minAgeMinutes  Int       @default(5)   // a freshly uploaded question waits this long before it is searched
  batchSize      Int       @default(2)   // questions processed per worker tick
  passes         Int       @default(5)   // independent verification passes per question (3-5)
  lastTickAt     DateTime?
  lastMessage    String?
  updatedAt      DateTime  @updatedAt

  @@map("pyq_date_configs")
}
