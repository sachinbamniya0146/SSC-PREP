// SSC Prep Hub — Prisma Database Schema
// Database: PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
  MODERATOR
}

// Department-level access for staff (role = MODERATOR). ADMIN always has all.
//   QUESTIONS  -> PYQ / main question bank upload + manage + syllabus tools
//   PRACTICE   -> practice-only question upload
//   VOCABULARY -> vocabulary words + vocab questions
//   SUPPORT    -> student support chat + question error reports
enum StaffPermission {
  QUESTIONS
  PRACTICE
  VOCABULARY
  SUPPORT
}

enum Platform {
  WEB
  APP
}

enum TestType {
  CHAPTER
  TOPIC
  SUBJECT
  MINI_MOCK
  FULL_MOCK
  PREVIOUS_YEAR
  SHIFT_WISE
  YEAR_WISE
  CUSTOM
  DAILY_PRACTICE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExplanationSource {
  PDF
  AI_GENERATED
  HUMAN_VERIFIED
  COMMUNITY_VERIFIED // AI explanation confirmed correct by >= 10 distinct students (see ai-explanation.service.ts)
}

enum TranslationStatus {
  HUMAN_VERIFIED
  AUTO_UNVERIFIED
}

enum VideoSource {
  YOUTUBE
  VIMEO
  S3_R2
  CUSTOM
}

enum ImportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum ChunkStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  SKIPPED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}

// ================= USER & AUTHENTICATION =================

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  phone            String?         @unique
  fullName         String
  passwordHash     String
  role             Role            @default(STUDENT)
  permissions      StaffPermission[] @default([])
  isEmailVerified  Boolean         @default(false)
  avatarUrl        String?
  
  // Gamification & Daily Streaks
  currentStreak    Int             @default(0)
  longestStreak    Int             @default(0)
  lastPracticeDate DateTime?
  xp               Int             @default(0)
  coins            Int             @default(0)
  hintQuota        Int             @default(3)

  // User preferences
  darkMode         Boolean         @default(false) @map("darkmode")  // Light mode is default
  preferredLanguage String         @default("en") @map("preferredlanguage")   // "en" or "hi"
  
  // User's personal OpenRouter API key for AI explanations
  openrouterApiKey String?         @map("openrouterapikey") // Encrypted API key for personal AI usage

  // Referral
  referralCode     String?         @unique
  referredByCode   String?         // referral code user signed up with
  freeSubFromReferral Boolean      @default(false)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  sessions         DeviceSession[]
  refreshTokens    RefreshToken[]
  subscriptions    Subscription[]
  payments         Payment[]
  testAttempts     TestAttempt[]
  bookmarks        Bookmark[]
  notes            UserNote[]
  dailyPractices   DailyPracticeHistory[]
  auditLogs        AuditLog[]
  dailyQuizAttempts DailyQuizAttempt[]
  weakTopicReports  WeakTopicReport[]
  weakTopicEntries  UserWeakTopic[]
  mockAccesses      MockAccess[]
  chapterPurchases  ChapterPurchase[]
  vocabWordProgress VocabWordProgress[]
  vocabDailyGoal    VocabDailyGoal?
  vocabWordPurchases VocabWordPurchase[]
  vocabSubscription  VocabSubscription?
  vocabUserState     VocabUserState?
  vocabRevisionSessions VocabRevisionSession[]
  studyPlanChapters  StudyPlanChapter[]
  studyPlanTests     StudyPlanTest[]
  pushSubscriptions  PushSubscription[]
  referralsMade     Referral[]      @relation("Referrer")
  referralsReceived Referral[]      @relation("Referee")
  referralWallet     ReferralWallet?
  earningsAsReferrer ReferralEarning[] @relation("EarningsAsReferrer")
  earningsAsReferee  ReferralEarning[] @relation("EarningsAsReferee")
  payoutMethod       PayoutMethod?
  withdrawalRequests WithdrawalRequest[]
  uploadBatches      QuestionUploadBatch[]
  studyPlans        StudyPlan[]
  telegram          TelegramUser?
  reviewCards       ReviewCard[]
  errorReports      QuestionErrorReport[]
  searchMisses      SearchMiss[]
  questionBankSets  QuestionBankSet[]
  userProgress      UserProgress[]
  reportMessagesSent      ReportMessage[]
  supportConversations    SupportConversation[]
  supportMessagesSent     SupportMessage[]
  explanationVotes        ExplanationVote[]

  @@map("users")
}

// ================= SPACED REPETITION =================
// SM-2 inspired review queue: wrong/weak answers schedule a card,
// correct answers space it out (1d → 3d → 7d → 14d → 30d).
model ReviewCard {
  id            String   @id @default(uuid())
  userId        String
  questionId    String
  easeFactor    Float    @default(2.5)   // SM-2 ease factor
  repetitions   Int      @default(0)     // consecutive correct reps
  intervalDays  Int      @default(1)
  dueAt         DateTime @default(now()) // when next review is due
  lapses        Int      @default(0)     // times card was forgotten
  suspended     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, dueAt, suspended])
  @@map("review_cards")
}

model DeviceSession {
  id           String   @id @default(uuid())
  userId       String
  platform     Platform
  deviceId     String
  ipAddress    String?
  userAgent    String?
  location     String?
  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // FIX Error #4: back-relation so a session's refresh tokens can be
  // revoked when the session is deactivated.
  refreshTokens RefreshToken[]

  @@index([userId, platform, isActive])
  @@map("device_sessions")
}

model RefreshToken {
  id              String    @id @default(uuid())
  userId          String
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  // FIX Error #4: link each refresh token to the DeviceSession it was
  // issued for, so that logging in on a new device can revoke ONLY the
  // old device's refresh tokens (not all of the user's tokens).
  deviceSessionId String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceSession DeviceSession? @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)

  @@index([deviceSessionId])
  @@map("refresh_tokens")
}

// ================= TAXONOMY & QUESTION BANK =================

model Exam {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "SSC CGL", "SSC CHSL"
  slug      String   @unique
  code      String   @unique // e.g. "CGL", "CHSL"
  isActive  Boolean  @default(true)

  questions Question[]
  sourcePdfs SourcePdf[]
  studyPlans       StudyPlan[]
  examPatterns ExamPattern[]
  questionBankSets QuestionBankSet[]
  userProgress     UserProgress[]
  testTemplates    TestTemplate[]

  @@map("exams")
}

model Subject {
  id        String    @id @default(uuid())
  name      String    // e.g. "Reasoning", "Quantitative Aptitude"
  nameHindi String?   // Hindi-medium name, e.g. "मात्रात्मक अभियोग्यता" — used by the syllabus-Excel importer
  slug      String    @unique
  chapters  Chapter[]
  questions Question[]
  sourcePdfs SourcePdf[]
  studyPlans       StudyPlan[]
  questionBankSets QuestionBankSet[]
  userProgress     UserProgress[]

  @@map("subjects")
}

model Chapter {
  id        String     @id @default(uuid())
  subjectId String
  name      String
  nameHindi String?    // Hindi-medium name — used by the syllabus-Excel importer
  slug      String
  topics    Topic[]
  questions Question[]
  weakTopicReports WeakTopicReport[]
  purchases ChapterPurchase[]
  questionBankSets QuestionBankSet[]
  userProgress     UserProgress[]

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, slug])
  @@map("chapters")
}

model Topic {
  id        String     @id @default(uuid())
  chapterId String
  name      String
  nameHindi String?    // Hindi-medium name — used by the syllabus-Excel importer
  slug      String
  subTopics SubTopic[]
  questions Question[]

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, slug])
  @@map("topics")
}

model SubTopic {
  id        String     @id @default(uuid())
  topicId   String
  name      String
  nameHindi String?    // Hindi-medium name — used by the syllabus-Excel importer
  slug      String
  questions Question[]

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  // Needed so the bulk syllabus importer can be re-run on the same Excel
  // without creating duplicate sub-topics (Chapter and Topic already have
  // this kind of uniqueness; SubTopic was the only one missing it).
  @@unique([topicId, slug])
  @@map("sub_topics")
}

// ================= PDF IMPORT & QUESTION PIPELINE =================

model SourcePdf {
  id               String        @id @default(uuid())
  filename         String
  originalUrl      String
  fileSize         Int
  uploadedByUserId String
  
  subjectId        String?
  examId           String?
  bookName         String?
  publisher        String?
  language         String        @default("Hindi/English")
  year             Int?
  shift            String?
  paperCode        String?

  createdAt        DateTime      @default(now())

  exam             Exam?         @relation(fields: [examId], references: [id])
  subject          Subject?      @relation(fields: [subjectId], references: [id])
  importBatches    ImportBatch[]
  questions        Question[]

  @@map("source_pdfs")
}

model ImportBatch {
  id              String        @id @default(uuid())
  sourcePdfId     String
  status          ImportStatus  @default(QUEUED)
  totalChunks     Int           @default(0)
  completedChunks Int           @default(0)
  failedChunks    Int           @default(0)
  errorMessage    String?
  
  createdAt       DateTime      @default(now())
  completedAt     DateTime?

  sourcePdf       SourcePdf     @relation(fields: [sourcePdfId], references: [id], onDelete: Cascade)
  chunks          ImportChunk[]
  questions       Question[]

  @@map("import_batches")
}

model ImportChunk {
  id            String      @id @default(uuid())
  importBatchId String
  chunkIndex    Int
  startPage     Int
  endPage       Int
  status        ChunkStatus @default(PENDING)
  errorMessage  String?
  processedAt   DateTime?

  batch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, chunkIndex])
  @@map("import_chunks")
}

// Bulk Upload History (admin panel "past uploads" view) — one row per
// Excel/CSV/Text/JSON/Word bulk-upload run, so admin can see what was
// uploaded, when, by whom, how many rows succeeded/failed, and undo an
// entire bad run (delete the batch + optionally the questions it created).
// This is a DIFFERENT, newer feature from the older ImportBatch/ImportChunk
// pair above (which is PDF-extraction-pipeline specific) — kept as its own
// model rather than overloading ImportBatch, since their lifecycles and
// admin-facing purposes don't overlap.
model QuestionUploadBatch {
  id           String   @id @default(uuid())
  adminId      String
  sourceType   String   // EXCEL | CSV | TEXT | JSON | WORD
  filename     String?
  totalRows    Int      @default(0)
  createdCount Int      @default(0)
  failedCount  Int      @default(0)
  errorsJson   Json?
  warningsJson Json?
  createdAt    DateTime @default(now())
  // Oct 7 2026 — upload status that survives page reloads / restarts:
  // RUNNING (still saving) | DONE | FAILED. Old rows default to DONE.
  status       String    @default("DONE")
  // rows that were the same question as one already in the bank -> waiting in Duplicate Review
  queuedCount  Int       @default(0)
  // duplicates the admin had already answered / that were already waiting in Duplicate Review
  skippedCount Int       @default(0)
  finishedAt   DateTime?
  errorMessage String?

  admin     User       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([adminId])
  @@map("question_upload_batches")
}

// NEW (Oct 6 2026 — Sachin: "duplicate question admin ke review me jaye").
// When an upload (or a scan of the bank) finds a question that is the SAME as one
// already live, it is NOT silently rejected: a row is queued here and the admin
// decides — keep the old one, keep the new one, or keep both.
// No foreign keys on purpose: a review must survive if either question is later
// deleted, and the screen shows "deleted" for a missing side.
model DuplicateReview {
  id                  String    @id @default(uuid())
  // PENDING | KEPT_EXISTING | KEPT_NEW | KEPT_BOTH
  status              String    @default("PENDING")
  // EXACT (everything identical) | SIMILAR (same question, some detail differs)
  matchType           String
  // names of the fields that differ (see common/duplicate-compare.ts); [] when EXACT
  differences         Json?
  // the question already live in the bank ("old" / side A)
  existingQuestionId  String?
  // scan mode: the second live question ("side B"). null in upload mode.
  candidateQuestionId String?
  // upload mode: the whole not-yet-saved question, saved only if the admin keeps it
  candidateJson       Json?
  searchHash          String?
  uploadBatchId       String?
  sourceRow           Int?
  createdById         String?
  resolvedById        String?
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([status, matchType, createdAt])
  @@index([existingQuestionId])
  @@index([candidateQuestionId])
  @@index([uploadBatchId])
  @@map("question_duplicate_reviews")
}

model Question {
  id                 String            @id @default(uuid())
  // NEW (Oct 3 2026): short, human-friendly unique number of every question
  // (1, 2, 3 ...). Shown to students on the question card + in error reports,
  // and typed by admin in the search box to jump straight to ONE question.
  questionNo         Int               @unique @default(autoincrement())
  sourcePdfId        String?
  importBatchId      String?
  // Bulk Upload History feature — tags a question with the upload run that
  // created it (Excel/CSV/Text/JSON path; the Word path leaves this null,
  // see bank-upload.service.ts's saveUploadBatchAfterTheFact() comment).
  // Distinct from importBatchId (an older/different import pipeline) —
  // kept separate rather than reusing it to avoid conflating two systems.
  uploadBatchId      String?
  
  subjectId          String
  chapterId          String?
  topicId            String?
  subTopicId         String?
  examId             String?
  
  year               Int?
  shift              String?
  paperCode          String?
  // NEW (Sep 29 2026): real exam date of a PYQ paper, "YYYY-MM-DD". Lets a
  // shift be identified as exam + date + shift + year straight from the Excel.
  examDate           String?
  // NEW (Oct 7 2026): which tier of the exam this PYQ came from — "TIER_1" | "TIER_2".
  // Filled by the PYQ date-mapping worker (or typed by admin), shown in the admin
  // PYQ export. Nullable: practice questions and older PYQs simply have no tier yet.
  examTier           String?

  questionText       String
  questionTextHindi  String?
  // Session 22 — Venn/figure-based diagram questions (e.g. reasoning
  // "select the correct Venn diagram" MCQs). Diagrams are stored as a
  // TYPE CODE from a fixed taxonomy (see backend/src/bank/diagram-types.ts)
  // + plain-text labels, NOT as image files — the frontend renders the
  // actual SVG from (type, labels) at zero storage/CDN cost and always
  // crisp on any screen. null/undefined = ordinary text question (default,
  // no behavior change for the other ~99% of questions).
  questionDiagramType   String?        // e.g. "V2" — set only when the QUESTION STEM itself is a diagram
  questionDiagramLabels Json?          // string[] — labels to place in the stem diagram's circles, in order
  // Session 24 — for diagram question types that AREN'T simple Venn
  // circles (mirror image, figure series, embedded figures, paper
  // folding, dice/clock, etc.) — genuinely arbitrary shapes that can't be
  // reduced to a type-code taxonomy. Stores a real uploaded image URL
  // (see S3Service.uploadQuestionImage) instead. Mutually exclusive with
  // questionDiagramType in practice — a question uses one or the other.
  questionImageUrl      String?
  optionsJson        Json              // Array of { key, text, textHi?, diagramType?, diagramLabels?, imageUrl? }.
                                        // diagramType = SVG Venn diagram (see diagram-types.ts). imageUrl = a real
                                        // uploaded picture (mirror image / figure series / etc — see above). An
                                        // option uses at most ONE of these three ways of being "the answer".
  correctAnswer      String            // e.g. "A" / "B" / "C" / "D"
  
  explanation        String?
  explanationHindi   String?
  explanationSource  ExplanationSource @default(PDF)
  explanationModel   String? // e.g. "meta-llama/llama-3.3-70b-instruct:free" — which free model generated/last-improved this
  explanationGeneratedAt DateTime? // when the current explanation text was (re)generated
  explanationVerifiedAt DateTime? // set when >= 10 students confirmed an AI explanation (source -> COMMUNITY_VERIFIED)
  translationStatus  TranslationStatus @default(HUMAN_VERIFIED)
  answerVerificationStatus String @default("UNVERIFIED_SINGLE_SOURCE") // VERIFIED_OFFICIAL, VERIFIED_MULTI_SOURCE, VERIFIED_COMPUTED, UNVERIFIED_SINGLE_SOURCE, DISPUTED
  lastVerifiedAt DateTime?
  verificationEvidence String? // solver derivation / multi-source notes backing the status
  aiConfidenceScore Float? // v1 §7.3 — extraction-model confidence (0-1); below threshold → review queue
  reviewStatus String @default("APPROVED") // v1 §7.4 — AI_DRAFT → IN_REVIEW → APPROVED / REJECTED (gate before PUBLISHED)
  isApproved         Boolean           @default(false)
  
  difficulty         Difficulty        @default(MEDIUM)
  marks              Float             @default(2.0)
  negativeMarks      Float             @default(0.5)
  
  searchHash         String?
  isActive           Boolean           @default(true)

  // v5 §37.4 — Report Error loop: auto soft-suspend after threshold
  errorReportCount   Int               @default(0)
  autoSuspended      Boolean           @default(false)
  suspendedAt        DateTime?

  // Video Solution Fields
  videoUrl           String?
  videoSource        VideoSource?
  videoTitle         String?
  videoDescription   String?
  videoDurationSeconds Int?
  videoLanguage      String?   // e.g. \"Hindi\", \"English\", \"Hinglish\"
  videoUploadedAt    DateTime?
  videoUploadedBy    String?   // userId of admin who added

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  sourcePdf          SourcePdf?        @relation(fields: [sourcePdfId], references: [id])
  importBatch        ImportBatch?      @relation(fields: [importBatchId], references: [id])
  uploadBatch        QuestionUploadBatch? @relation(fields: [uploadBatchId], references: [id])
  subject            Subject           @relation(fields: [subjectId], references: [id])
  chapter            Chapter?          @relation(fields: [chapterId], references: [id])
  topic              Topic?            @relation(fields: [topicId], references: [id])
  subTopic           SubTopic?         @relation(fields: [subTopicId], references: [id])
  exam               Exam?             @relation(fields: [examId], references: [id])
  
  versions           QuestionVersion[]
  answers            AttemptAnswer[]
  bookmarks          Bookmark[]
  notes              UserNote[]
  reviewCards        ReviewCard[]
  errorReports       QuestionErrorReport[]
  explanationVotes   ExplanationVote[]
  pyqDateMap         PyqDateMap?

  @@index([subjectId, examId, year, shift])
  @@index([searchHash])
  @@index([isApproved, isActive])
  @@index([errorReportCount])
  @@index([examId, subjectId, isApproved, isActive]) // CGL/compose hot path
  @@map("questions")
}

model QuestionVersion {
  id             String   @id @default(uuid())
  questionId     String
  editedByUserId String
  previousText   String
  previousOptions Json
  previousAnswer String
  reason         String?
  createdAt      DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_versions")
}

// ================= TEST ENGINE & ATTEMPTS =================

model TestTemplate {
  id               String        @id @default(uuid())
  title            String
  description      String?
  type             TestType
  durationMinutes  Int           @default(60)
  totalQuestions   Int           @default(100)
  totalMarks       Float         @default(200.0)
  isPremium        Boolean       @default(false)
  isActive         Boolean       @default(true)
  priceInr         Int           @default(0)  // Price in INR for premium tests

  // NEW (Sep 2026 — "us exam ke menu par usi exam ke mocks/questions dikhein"
  // audit): TestTemplate had NO link to Exam at all — a mock test row had no
  // way to record which exam it belonged to, so /mocks always returned every
  // mock across every exam mixed together with no way to filter. Nullable
  // because a few templates are deliberately cross-exam/generic (the
  // "tpl-practice" quick-practice placeholder in bank.service.ts#attempt()
  // has no single exam). Every exam-specific creation path (auto PYQ mocks
  // in bank-upload.service.ts, year-wise custom tests and daily tests in
  // tests.service.ts/daily-test.service.ts) now sets this — see those files
  // for the actual writes. onDelete: SetNull so deleting an Exam doesn't
  // cascade-delete historical mock templates/attempts tied to it.
  examId           String?
  // NEW (Sep 29 2026): PYQ-mock category meta, filled by the auto-mock creator so
  // /mocks can group Exam > Year > Date > Shift without parsing titles.
  year             Int?
  shift            String?
  examDate         String?
  exam             Exam?         @relation(fields: [examId], references: [id], onDelete: SetNull)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  
  attempts         TestAttempt[]
  pdfExports       TestPdfExport[]
  attemptStats     TestAttemptStats?

  @@index([examId])
  @@map("test_templates")
}

// v6 §7 — Test paper + Answer-key PDF export with mandatory 4-pass QA gate.
// PDFs stored as bytea (no volume config needed); binary data never exposed via API JSON.
model TestPdfExport {
  id               String     @id @default(uuid())
  testTemplateId   String     @unique
  testTemplate     TestTemplate @relation(fields: [testTemplateId], references: [id], onDelete: Cascade)

  paperPdf         Bytes?     // test paper (bilingual)
  answerKeyPdf     Bytes?     // answer key + solutions (bilingual)
  questionSnapshot Json?      // canonical QID list at generation time (pass-4 regression diff base)

  // 4-pass QA gate (v6 §7 — sab passes hone par hi publish):
  pass1Field       Boolean    @default(false) // automated: PDF marked-correct === DB correct_index
  pass2Structural  Boolean    @default(false) // automated: PDF option list === live option list 1:1
  pass3SpotCheck   Boolean    @default(false) // admin sampled review
  pass4Regression  Boolean    @default(false) // pre-publish re-compare vs canonical source
  isPublished      Boolean    @default(false)
  publishedAt      DateTime?
  lastGeneratedAt  DateTime?

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("test_pdf_exports")
}

model TestAttempt {
  id               String        @id @default(uuid())
  userId           String
  testTemplateId   String
  status           AttemptStatus @default(IN_PROGRESS)
  
  score            Float         @default(0.0)
  totalCorrect     Int           @default(0)
  totalWrong       Int           @default(0)
  totalSkipped     Int           @default(0)
  accuracyPercent  Float         @default(0.0)
  rank             Int?
  percentile       Float?
  
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  // Server-authoritative deadline: expiresAt = startedAt + template duration.
  // Clients may display a countdown from this, but the server enforces it:
  // a submit after expiresAt is treated as auto-submit at expiry (no extra time).
  expiresAt        DateTime?

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  testTemplate     TestTemplate  @relation(fields: [testTemplateId], references: [id])
  answers          AttemptAnswer[]

  // v3 §6.4 Daily Test / v6 §2a — stable per-attempt question composition
  // (question ids in order; server composes from this, so a mid-test refresh
  // returns the identical paper instead of re-sampling the pool).
  questionSnapshot Json?

  @@index([userId, status])
  @@index([testTemplateId, status]) // rank/percentile + leaderboard hot path
  @@map("test_attempts")
}

model AttemptAnswer {
  id                 String      @id @default(uuid())
  testAttemptId     String
  questionId         String
  selectedOption     String?     // "A", "B", "C", "D" or null if skipped
  isCorrect          Boolean     @default(false)
  timeSpentSeconds   Int         @default(0)
  isMarkedForReview Boolean     @default(false)

  testAttempt TestAttempt @relation(fields: [testAttemptId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id])

  @@unique([testAttemptId, questionId])
  @@map("attempt_answers")
}

// ================= SUBSCRIPTIONS & PAYMENTS =================

model Plan {
  id             String   @id @default(uuid())
  name           String   // e.g. "Monthly Pass (1 Month)", "Super Pass (24 Months)"
  durationMonths Int
  priceInr       Float
