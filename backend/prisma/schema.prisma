// NEW (Oct 3 2026) — persistent weak-topic tracker.
// One row per (student, chapter/topic/sub-topic). A row is created / re-opened
// (status WEAK) every time the student gets a question of that scope wrong or
// skips it in ANY submitted test (mock, sectional, PYQ, daily test, quiz,
// practice). It only turns STRENGTHENED when the student finishes a practice
// set of that scope with enough accuracy — until then it stays in the weak
// list and keeps being counted.
model UserWeakTopic {
  id                 String    @id @default(uuid())
  userId             String
  subjectId          String?
  chapterId          String?
  topicId            String?
  subTopicId         String?
  // "<chapterId>|<topicId>|<subTopicId>" (empty string for a missing level) — makes the row unique per scope
  scopeKey           String
  status             String    @default("WEAK") // WEAK | STRENGTHENED
  wrongCount         Int       @default(0)      // lifetime wrong + skipped in tests
  attemptedCount     Int       @default(0)      // lifetime questions seen in tests
  practiceSetsDone   Int       @default(0)      // completed practice sets of this scope since it turned weak
  practiceCorrect    Int       @default(0)
  practiceTotal      Int       @default(0)
  lastPracticeScore  Int?
  lastSourceAttemptId String?
  firstDetectedAt    DateTime  @default(now())
  lastDetectedAt     DateTime  @default(now())
  strengthenedAt     DateTime?
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeKey])
  @@index([userId, status])
  @@index([userId, chapterId])
  @@map("user_weak_topics")
}

