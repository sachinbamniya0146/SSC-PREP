# Production .env for docker-compose (copy to .env and customize)
# JWT AUTHENTICATION (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-secret-32-chars-minimum
JWT_ACCESS_SECRET=your-super-secret-access-secret-32-chars-minimum
JWT_REFRESH_SECRET=your-super-secret-refresh-secret-32-chars-minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ADMIN SEED CONFIGURATION (change in production!)
ADMIN_DEFAULT_EMAIL=sachinbamniya0142@gmail.com
ADMIN_DEFAULT_PASSWORD=sachin@0142sachin@01

# AI / OCR SERVICE
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=deepseek-v4-flash-free
OPENAI_BASE_URL=https://opencode.ai/zen/v1

# Cashfree Payment Gateway — REQUIRED (monetization.service.ts calls Cashfree,
# not PayU/Razorpay — those sections below are legacy/unused, kept only for
# reference). Get these from: Merchant Dashboard → Developers → API Keys.
#
# IMPORTANT — "authentication Failed" on every purchase almost always means
# ONE of these two things:
#   1. CASHFREE_APP_ID / CASHFREE_SECRET_KEY below were pasted with a stray
#      trailing space or newline. Re-copy them fresh from the dashboard.
#   2. CASHFREE_ENV does NOT match the key type you generated:
#        - Sandbox/Test keys  -> CASHFREE_ENV=TEST  (or leave unset)
#        - Live/Production keys -> CASHFREE_ENV=PRODUCTION
#      Mixing these (e.g. Production keys with CASHFREE_ENV unset, which
#      defaults to TEST and calls sandbox.cashfree.com) always fails auth.
# After changing any of these, restart the backend container — env vars are
# only read once at process boot, a hot-reload will NOT pick up the change.
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENV=PRODUCTION
# Optional — only if you configured a DIFFERENT webhook secret in the
# Cashfree dashboard than your main secret key. Leave blank to reuse
# CASHFREE_SECRET_KEY for webhook signature verification.
CASHFREE_WEBHOOK_SECRET=
# Optional — explicit webhook URL to register with Cashfree. Leave blank to
# auto-build from BACKEND_PUBLIC_URL + /api/v1/payments/webhook.
CASHFREE_WEBHOOK_URL=

# --- Legacy / unused (kept for reference only — NOT called by current code) ---
# PayU Payment Gateway (superseded by Cashfree above)
PAYU_MERCHANT_KEY=eUXkOt
PAYU_MERCHANT_SALT=e0YkggUb7yKMMj39c3cxXk3VSSTnUeuc
PAYU_BASE_URL=https://test.payu.in
PAYU_TEST_MODE=true

# Legacy Razorpay (for backward compatibility, will be removed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=ssc-dev-webhook-secret

# PDF Storage
PDF_STORAGE_DIR=files/pdf

# GOOGLE LOGIN (free — Google Cloud Console OAuth client)
GOOGLE_CLIENT_ID=449330513452-02oguopf78aldfio3r2pa98dujkbkheo.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# EMAIL (SMTP) — configure for production (Gmail App Password / Zoho / Resend / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@sscprephub.in

# TELEGRAM BOT (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# DATABASE (auto-configured in docker-compose)
