# Production .env for docker-compose (copy to .env and customize)
# JWT AUTHENTICATION (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-secret-32-chars-minimum
JWT_ACCESS_SECRET=your-super-secret-access-secret-32-chars-minimum
JWT_REFRESH_SECRET=your-super-secret-refresh-secret-32-chars-minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ADMIN SEED CONFIGURATION (change in production!)
ADMIN_DEFAULT_EMAIL=admin@sscprephub.in
ADMIN_DEFAULT_PASSWORD=ChangeMeInProduction123!

# AI / OCR SERVICE
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=deepseek-v4-flash-free
OPENAI_BASE_URL=https://opencode.ai/zen/v1

# PayU Payment Gateway (Production - get from PayU Merchant Dashboard)
PAYU_MERCHANT_KEY=your-payu-merchant-key
PAYU_MERCHANT_SALT=your-payu-merchant-salt
PAYU_BASE_URL=https://secure.payu.in
PAYU_TEST_MODE=false

# Legacy Razorpay (for backward compatibility, will be removed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=ssc-dev-webhook-secret

# PDF Storage
PDF_STORAGE_DIR=files/pdf

# GOOGLE LOGIN (free — Google Cloud Console OAuth client)
GOOGLE_CLIENT_ID=449330513452-02oguopf78aldfio3r2pa98dujkbkheo.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# EMAIL (SMTP) — configure for production (Gmail App Password / Zoho / Resend / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@sscprephub.in

# TELEGRAM BOT (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# DATABASE (auto-configured in docker-compose)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ssc_prep_hub?schema=public&connection_limit=20
# REDIS_HOST=redis
# REDIS_PORT=6379
# MEILISEARCH_HOST=http://meilisearch:7700
# MEILISEARCH_API_KEY=

# GEMINI API (optional)
GEMINI_API_KEY=your-gemini-api-key

# POSTGRES PASSWORD (used in docker-compose)
POSTGRES_PASSWORD=postgres