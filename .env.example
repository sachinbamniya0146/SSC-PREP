# SSC Prep Hub — Environment Variables Template (.env.example)

# PORT & SERVER
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# DATABASE (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sscprephub?schema=public&connection_limit=20"

# REDIS (Cache & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT AUTHENTICATION
JWT_ACCESS_SECRET="change-this-to-a-secure-random-access-secret-32-chars-min"
JWT_REFRESH_SECRET="change-this-to-a-secure-random-refresh-secret-32-chars-min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# GOOGLE OAUTH (leave empty to disable endpoint → returns 403)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# EMAIL OTP (SMTP — empty = dev mode, OTP printed to server logs)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SSC Prep Hub <noreply@sscprephub.in>"

# ADMIN SEED CONFIGURATION
ADMIN_DEFAULT_EMAIL="admin@sscprephub.in"
ADMIN_DEFAULT_PASSWORD="ChangeMeInProduction123!"

# RAZORPAY — optional, not used by this deployment (kept for reference only)
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"

# CASHFREE PAYMENT GATEWAY — how students PAY US (plans, chapter PDFs, mock
# tests). Get these from Cashfree Dashboard > Developers > API Keys.
# CASHFREE_ENV=TEST uses sandbox.cashfree.com; PRODUCTION uses api.cashfree.com.
CASHFREE_APP_ID="YourCashfreeAppId"
CASHFREE_SECRET_KEY="YourCashfreeSecretKey"
CASHFREE_WEBHOOK_SECRET=""
CASHFREE_ENV="TEST"
CASHFREE_WEBHOOK_URL=""
BACKEND_PUBLIC_URL="https://api.sscprephub.in"

# CASHFREE PAYOUTS — a SEPARATE Cashfree product used only for Refer & Earn
# withdrawals (how WE pay commission OUT to students). Requires Payouts to
# be activated + KYC-verified on the Cashfree dashboard first; you then get
# a SEPARATE Client ID/Secret here (not the same as CASHFREE_APP_ID above).
# Leave blank and admin can still approve withdrawals — the money transfer
# just has to be done manually until these are filled in.
CASHFREE_PAYOUT_CLIENT_ID=""
CASHFREE_PAYOUT_CLIENT_SECRET=""
CASHFREE_PAYOUT_ENV="TEST"

# CLOUDFLARE R2 / AWS S3 STORAGE
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET_NAME="sscprephub-pdf-storage"
S3_ACCESS_KEY_ID="YourS3AccessKeyId"
S3_SECRET_ACCESS_KEY="YourS3SecretAccessKey"

# MEILISEARCH (Search Engine)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_MASTER_KEY="MasterKeyForSearch123"

# AI / OCR SERVICE
OPENAI_API_KEY=""
LLM_EXPLANATION_MODEL="gpt-4o-mini"
